# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MYSQL CONFIGURATION (Single Source of Truth — Hostinger Production)
MYSQL_HOST="localhost"
# Optional override when running in Cloud Run preview to connect to remote MySQL instead of loopback 127.0.0.1:
MYSQL_REMOTE_HOST=""
MYSQL_PORT="3306"
MYSQL_USER="your_mysql_user"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="your_mysql_database"

# SECURITY CONFIGURATION (Used strictly for session token signing — never modifies database users or passwords)
SESSION_SECRET="replace_with_random_64_char_hex_secret"

# SYSTEM ADMINISTRATOR RECOVERY BOOTSTRAP (Used ONLY on first initialization if System Administrator does not yet exist in MySQL)
SYSADMIN_DEFAULT_USERNAME="sysadmin"
SYSADMIN_DEFAULT_EMAIL="sysadmin@wijna.org"
SYSADMIN_DEFAULT_NAME="System Administrator"
SYSADMIN_DEFAULT_PASSWORD=""

